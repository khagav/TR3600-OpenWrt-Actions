diff --git a/target/linux/mediatek/dts/mt7987b-cudy-tr3600-v1.dts b/target/linux/mediatek/dts/mt7987b-cudy-tr3600-v1.dts
--- a/target/linux/mediatek/dts/mt7987b-cudy-tr3600-v1.dts
+++ b/target/linux/mediatek/dts/mt7987b-cudy-tr3600-v1.dts
@@ -21,10 +21,31 @@
 	};
 
 	chosen {
-		bootargs = "console=ttyS0,115200n1 earlycon=uart8250,mmio32,0x11000000 pci=pcie_bus_perf";
+		/* pci=noaer: the MT7990 PCIe link on this board can emit AER
+		 * "synchronous external abort" storms, and every abort is a DMA
+		 * transaction that may already have been lost - the recovery path
+		 * ends in a panic. Reporting buys nothing here, so stop reporting
+		 * (same reasoning as disabling WED below).
+		 */
+		bootargs = "console=ttyS0,115200n1 earlycon=uart8250,mmio32,0x11000000 pci=pcie_bus_perf pci=noaer";
 		stdout-path = "serial0:115200n8";
 	};
 
+	/* pstore/ramoops - deliberately NOT added here.
+	 *
+	 * The stock OpenWrt DTS (via mt7987.dtsi / the SoC dtsi) already
+	 * provides a 64 KiB ramoops at 0x5ffb0000 plus a secmon region at
+	 * 0x5ffc0000. An earlier version of this patch added its own 1 MiB
+	 * region at 0x5ff00000, which OVERLAPPED the stock ramoops + secmon;
+	 * the kernel rejected it (ramoops: already initialized, "probe with
+	 * driver ramoops failed with error -22") and only the stock 64 KiB was
+	 * used. 64 KiB proved sufficient to capture the full dmesg + console
+	 * of a real panic (2026-11-13, MT7996 PCIe synchronous external
+	 * abort), so we rely on the stock node. If the stock node ever goes
+	 * away, add a ramoops node here in a free 1 MiB region below the
+	 * stock one (e.g. 0x5fe00000, which /proc/iomem shows as reserved).
+	 */
+
 	/* Cudy TR3600 v1 has 512 MiB DDR4 at 0x40000000. */
 	memory {
 		device_type = "memory";
