#!/bin/sh
#
# Cudy TR3600 v1 / Kwrt: WAN/4G self-heal watchdog.
#
# Escalating recovery, one step per detection cycle (so a single hiccup never
# rips the whole box down):
#   healthy   -> ping a target succeeds            (reset all counters)
#   phase 1   -> relaunch the default-route iface + tether (renew DHCP)
#   phase 2   -> USB re-enumerate the dongle: re-power the USB port via the
#                usb3en GPIO if present, else unbind/bind the card's USB device
#                (equivalent of stock's usb_power_restart, without hard-coding
#                a GPIO that may not be exported on this DTS).  After this the
#                netifd/devname changes, and files/hotplug.d/net/25-tr3600-usb-
#                tether re-points network.tether to the freshly enumerated netdev.
#   phase 3   -> reboot the whole router  (LAST resort, opt-in: allow_reboot=1)
#
# Board-gated (only runs on cudy,tr3600-v1). ASCII, busybox-ash. Intended to be
# driven once a minute by /etc/init.d/tr3600-4g-wwatch (cron), not as a daemon.
#
# Config section (/etc/config/tr3600 -> 'config wwatch'):
#   option enabled 1        # master switch
#   option thresh 2         # consecutive offline hits before acting
#   option target '223.5.5.5 8.8.8.8'   # space separated probe hosts
#   option allow_reboot 0   # 1 = permit the phase-3 full reboot

B=/var/run/tr3600-4g-wwatch
mkdir -p "$B" 2>/dev/null

[ -f /tmp/sysinfo/board_name ] || exit 0
[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "cudy,tr3600-v1" ] || exit 0

log() { logger -t tr3600-wwatch "$*"; }

# ---- config ----------------------------------------------------------------
# Read each key explicitly (uci show+-n is not a portable combo; explicit get
# also fails safe back to the defaults below if the section is absent).
enabled="$(uci -q get tr3600.wwatch.enabled 2>/dev/null)";  enabled="${enabled:-1}"
thresh="$(uci -q get  tr3600.wwatch.thresh 2>/dev/null)";   thresh="${thresh:-3}"
target="$(uci -q get  tr3600.wwatch.target 2>/dev/null)";   target="${target:-223.5.5.5 8.8.8.8}"
allow_reboot="$(uci -q get tr3600.wwatch.allow_reboot 2>/dev/null)"; allow_reboot="${allow_reboot:-0}"
# Seconds to hold the fail counter at 0 once tether is up, so a routed-mode
# cellular dongle has time to finish its PPP dial before we start counting
# it as offline.  Default 120 s; a cold dial on a congested cell can take
# longer, so keep this comfortably above the udhcpc retry interval.
dial_grace="$(uci -q get tr3600.wwatch.dial_grace 2>/dev/null)"; dial_grace="${dial_grace:-120}"
[ "$enabled" = "1" ] || exit 0

# ---- helpers ---------------------------------------------------------------
defroute_if() {
	ip -4 route show default 2>/dev/null | awk '{print $5; exit}'
}

ping_ok() {
	local t
	for t in $target; do
		ping -c1 -w3 "$t" >/dev/null 2>&1 && return 0
	done
	return 1
}

# Given a netdev name, find its parent USB device node (has idVendor) and
# unbind+bind it under drivers/usb, forcing a re-enumeration (like replug).
replug_usb() {
	local net="$1" p d busid
	[ -n "$net" ] || return 1
	p="$(readlink -f "/sys/class/net/$net/device" 2>/dev/null)"
	[ -n "$p" ] || return 1
	d="$p"
	while [ -n "$d" ] && [ "$d" != "/" ]; do
		[ -f "$d/idVendor" ] && break
		d="$(dirname "$d")"
	done
	[ -n "$d" ] && [ "$d" != "/" ] && [ -f "$d/idVendor" ] || return 1
	busid="$(basename "$d")"
	if [ -w /sys/bus/usb/drivers/usb/unbind ]; then
		echo "$busid" > /sys/bus/usb/drivers/usb/unbind 2>/dev/null
		sleep 1
		echo "$busid" > /sys/bus/usb/drivers/usb/bind 2>/dev/null
		return 0
	fi
	return 1
}

# Cut USB VBUS for 1s if the power-enable GPIO is exported (stock had
# /sys/class/gpio/usb3en). Best-effort; silent if the node is absent.
usb_power_cycle() {
	local g
	for g in /sys/class/gpio/usb3en/value /sys/class/gpio/usb_power_en/value; do
		[ -w "$g" ] || continue
		echo 0 > "$g" 2>/dev/null
		sleep 1
		echo 1 > "$g" 2>/dev/null
		return 0
	done
	return 1
}

# Enumerate every real USB device node and unbind+bind it, forcing the kernel
# to re-probe (equivalent of a physical replug).  Works even when the netdev
# is GONE - we walk /sys/bus/usb/devices, not /sys/class/net.  Root hubs
# (busid contains ":") are skipped so we never kill a whole controller.
usb_replug_all() {
	local d busid vid found=0
	for d in /sys/bus/usb/devices/*/idVendor; do
		[ -f "$d" ] || continue
		busid="$(basename "$(dirname "$d")")"
		# Only touch REAL USB devices (busid "1-1" / "2-1.1").  Root hubs
		# are named usb1/usb2 (no dash) with idVendor 1d6b (Linux
		# Foundation); interface nodes are "1-1:1.0" (has a colon).
		# Unbinding a root hub resets the WHOLE controller and can hang
		# the box -> 60s USB re-enumeration storm -> mtk-wdt reboot.
		case "$busid" in
			*:*) continue ;;
			usb*) continue ;;
			*-*) ;;
			*) continue ;;
		esac
		vid="$(cat "/sys/bus/usb/devices/$busid/idVendor" 2>/dev/null)"
		[ "$vid" = "1d6b" ] && continue
		[ -w /sys/bus/usb/drivers/usb/unbind ] || return 1
		echo "$busid" > /sys/bus/usb/drivers/usb/unbind 2>/dev/null
		sleep 1
		echo "$busid" > /sys/bus/usb/drivers/usb/bind 2>/dev/null
		found=1
	done
	[ "$found" = "1" ]
}

# Find the netdev currently bound to a USB device (has idVendor in its parent
# path).  Skips the SoC ethernets and bridges.  Echoes the first match.
usb_netdev() {
	local n p
	for n in /sys/class/net/*; do
		n="$(basename "$n")"
		case "$n" in br-*|lo|ip6tnl*|phy*|dheth*) continue ;; esac
		p="$(readlink -f "/sys/class/net/$n/device" 2>/dev/null)"
		while [ -n "$p" ] && [ "$p" != "/" ]; do
			[ -f "$p/idVendor" ] && { echo "$n"; return 0; }
			p="$(dirname "$p")"
		done
	done
	return 1
}

# ---- tether device health check (NEW) --------------------------------------
# The watchdog used to act only when ping failed; if the dongle's netdev node
# vanished (USB re-enumerated under a different name, or the device dropped)
# while ping was still fine, nothing fixed it.  This runs EVERY cycle: if
# network.tether.device no longer exists, re-point it at the current USB
# netdev or force a USB re-enumeration so netifd can bring tether back up.
fix_tether_device() {
	local tdev newdev
	tdev="$(uci -q get network.tether.device 2>/dev/null)"
	[ -n "$tdev" ] || return 0
	[ -e "/sys/class/net/$tdev" ] && return 0

	log "tether device $tdev missing; rescanning"
	newdev="$(usb_netdev)"
	if [ -n "$newdev" ]; then
		uci -q set "network.tether.device=$newdev"
		uci -q commit network
		log "tether device -> $newdev (ifup)"
		ifup tether >/dev/null 2>&1
	else
		# No real USB device to fix - do NOT touch the USB bus.  usb_replug_all
		# would walk the root hubs (usb1/usb2) and reset the whole controller
		# (the cause of the 60s re-enumeration storm + watchdog reboots).
		# Only try the GPIO power cycle (harmless if the node is absent) and
		# leave the bus alone; log so an operator can see the tether is gone.
		log "no USB netdev; tether $tdev missing (bus untouched)"
		usb_power_cycle
	fi
	return 1
}

# ---- main ------------------------------------------------------------------
# Device health first (cheap, no network needed), then the ping ladder.
fix_tether_device
if ping_ok; then
	rm -f "$B/fail" "$B/phase" 2>/dev/null
	: > "$B/alive" 2>/dev/null
	exit 0
fi

# A USB cellular dongle (e.g. the CMIOT ML307R) that works in routed mode
# gives the router a DHCP lease (192.168.0.100) as soon as its internal
# Ethernet NIC enumerates, but the CELLULAR side (the actual PPP dial to the
# carrier) takes 30-120 s to come up.  During that window ping_ok() is false
# even though everything is fine and will be fine.  If we let the fail
# counter climb to thresh (default 2, ~2 min) and then escalate to phase 2
# (USB re-enumerate) we *kill a perfectly good dongle* -- exactly what
# happened on the live box: cdc_ether eth2 registered, DHCP lease obtained,
# then wwatch phase2 tore the USB device down (can't set config, -71) and it
# never recovered.
#
# So: while the tether device node EXISTS (the dongle enumerated fine and
# netifd owns it), treat a ping failure as a *dial / cellular* problem, not a
# USB problem.  Give the cellular side a grace window, then only restart the
# tether interface (phase 1) to re-trigger the dial; NEVER re-enumerate the
# USB device (phase 2) while the device node is present.
#
# The grace window starts when tether is up (has an address).  While the
# window is open the fail counter is held at 0 so phase 1 is not reached.
# After the window, if the cellular side still cannot reach the internet we
# climb phase 1 (tether bounce) -- still cheap and non-destructive.
tether_state="$(ifstatus tether 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null)"
if [ "$tether_state" = "true" ]; then
	if [ ! -f "$B/tether_up_since" ]; then
		date +%s > "$B/tether_up_since" 2>/dev/null
		log "tether is up; dial grace window started"
	fi
	up_since="$(cat "$B/tether_up_since" 2>/dev/null || echo 0)"
	now="$(date +%s 2>/dev/null || echo 0)"
	# hold the fail counter at 0 during the dial grace window
	if [ "$up_since" -gt 0 ] && [ $(( now - up_since )) -lt "$dial_grace" ]; then
		rm -f "$B/fail" "$B/phase" 2>/dev/null
		log "tether dialing (up $(($(date +%s 2>/dev/null || echo 0) - up_since))s < grace $dial_grace s); holding"
		exit 0
	fi
else
	rm -f "$B/tether_up_since" 2>/dev/null
fi

f=$(( $(cat "$B/fail" 2>/dev/null || echo 0) + 1 ))
echo "$f" > "$B/fail" 2>/dev/null
wif="$(defroute_if)"
log "offline #$f (defroute_if=${wif:-none})"
[ "$f" -lt "$thresh" ] && exit 0

phase=$(( $(cat "$B/phase" 2>/dev/null || echo 0) ))

if [ "$phase" -le 0 ]; then
	echo 1 > "$B/phase" 2>/dev/null
	log "phase1: relaunch ${wif:-wan} + tether"
	[ -n "$wif" ] && { ifdown "$wif" >/dev/null 2>&1; sleep 1; ifup "$wif" >/dev/null 2>&1; }
	if uci -q get network.tether >/dev/null 2>&1; then
		ifdown tether >/dev/null 2>&1; sleep 1; ifup tether >/dev/null 2>&1
	fi
	exit 0
fi

if [ "$phase" -le 1 ]; then
	echo 2 > "$B/phase" 2>/dev/null
	log "phase2: USB re-enumerate dongle"
	# prefer re-powering the port; also force a device replug so a hung
	# cdc_ether/usb device actually re-probes.
	usb_power_cycle
	tnet="$(uci -q get network.tether.device 2>/dev/null)"
	replugged=0
	[ -n "$tnet" ] && { replug_usb "$tnet" && replugged=1; }
	# if tether tracks a usb* netdev, replug that too
	for n in $(ls /sys/class/net 2>/dev/null); do
		case "$n" in
			usb*) replug_usb "$n" && replugged=1 ;;
		esac
	done
	# netdev node gone entirely -> re-enumerate at the USB bus level
	[ "$replugged" = "1" ] || usb_replug_all
	exit 0
fi

if [ "$allow_reboot" = "1" ] && [ "$phase" -le 2 ]; then
	echo 3 > "$B/phase" 2>/dev/null
	log "phase3: full reboot (allow_reboot=1)"
	sleep 2
	reboot
	exit 0
fi

[ $(( f % 20 )) -eq 0 ] && log "still offline after ladder (phase=$phase, allow_reboot=$allow_reboot)"
exit 0
